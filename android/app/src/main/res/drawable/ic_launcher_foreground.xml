    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="256"
    android:viewportHeight="256">

    <group
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:pivotX="128"
        android:pivotY="128">

        <!-- Outer vault ring: annulus r=80..60, cobalt -->
        <path
            android:fillColor="#2563EB"
            android:fillType="evenOdd"
            android:pathData="M128,48 C172.2,48 208,75.8 208,128 C208,180.2 172.2,208 128,208 C83.8,208 48,180.2 48,128 C48,75.8 83.8,48 128,48 Z
                             M128,68 C161.1,68 188,94.9 188,128 C188,161.1 161.1,188 128,188 C94.9,188 68,161.1 68,128 C68,94.9 94.9,68 128,68 Z" />

        <!-- Inner accent ring: annulus r=42..36 -->
        <path
            android:fillColor="#60A5FA"
            android:fillType="evenOdd"
            android:pathData="M128,86 C151.2,86 170,104.8 170,128 C170,151.2 151.2,170 128,170 C104.8,170 86,151.2 86,128 C86,104.8 104.8,86 128,86 Z
