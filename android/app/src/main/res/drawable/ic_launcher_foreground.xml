<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground = the actual Vaultly logo, redrawn as vectors.
  Geometry and colors are identical to frontend/scripts/generate-logo.mjs:
    navy background #0f172a, cobalt outer ring #2563eb (annulus r60..80),
    accent #60a5fa inner ring (r36..42), 8 spokes (r14..58, width 8), hub (r16).
  The group scales content to 92% so the ring stays inside the adaptive-icon
  safe zone (66/108 of the canvas) on circular launcher masks.
-->
